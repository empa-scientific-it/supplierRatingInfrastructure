# Welche openBIS-Version lokal gestartet wird.
# Zum Wechseln: Wert ändern, dann "docker compose down" und "docker compose up -d".
# Jede Version hat eigene Volumes, die Daten bleiben also beim Wechsel erhalten.
#   7.0.0      = wie dev308 (Workshop) und alle Empa-Instanzen ab 2027
#   20.10.13.1 = wie lab303 (aktuelle Produktion)
OPENBIS_VERSION=7.0.0