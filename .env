# Which openBIS version is started locally.
# To switch: change the value, then run "docker compose down" and "docker compose up -d".
# Each version has its own volumes, so the data is kept when switching.
#   7.0.0      = like dev308 (workshop) and all Empa instances from 2027
#   20.10.13.1 = like lab303 (current production)
OPENBIS_VERSION=20.10.13.1